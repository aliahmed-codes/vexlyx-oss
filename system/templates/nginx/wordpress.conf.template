# Nginx site config for WordPress projects (F5.7 — official image pair).
# Generated by docker_manager.py -- do NOT edit manually.
# Proxies PHP requests to the "app" (wordpress:php8.3-fpm-alpine) service over FastCGI.

# Traefik terminates TLS at the edge and always proxies to this container
# over plain HTTP, so PHP never sees $_SERVER['HTTPS'] set on an https://
# request (found live while debugging F5.21's php.conf.template, and the
# exact same gap applies here). Without this, WordPress's own HTTPS
# enforcement on wp-login.php/wp-admin redirects to https on every request
# and loops forever, since PHP always thinks it's still on HTTP.
map $http_x_forwarded_proto $fastcgi_https {
    default "";
    https "on";
}

server {
    listen 80;
    listen [::]:80;
    server_name _;
    root /var/www/html;
    index index.php index.html;

    client_max_body_size 64m;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        # {{app_upstream}} is this project's own unique container name, not
        # the bare "app" service name -- Compose aliases services by their
        # plain name on every network they join, including the shared
        # external traefik-net, so "app" resolves ambiguously across
        # multiple WordPress/no-build-PHP projects deployed at once (found
        # live: nginx randomly proxied to a DIFFERENT project's php-fpm).
        fastcgi_pass {{app_upstream}}:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS $fastcgi_https;
    }

    location ~* \.(jpg|jpeg|png|gif|webp|css|js|ico|svg|woff|woff2)$ {
        expires 30d;
        access_log off;
        try_files $uri =404;
    }

    location ~ /\.ht {
        deny all;
    }
}
