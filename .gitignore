# Dependencies
node_modules/

# Turborepo
.turbo/

# Build outputs
dist/
.next/
out/

# TypeScript
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.production
.env.*.local

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Debug logs
npm-debug.log*
pnpm-debug.log*

# Prisma (generated)
apps/api/prisma/generated/

# Docker volumes
docker/data/

# Shared Maildir storage between Postfix and Dovecot (F4.1/F4.2) — runtime mail data
docker/mail-data/*
!docker/mail-data/.gitkeep

# Runtime mailbox credentials and offline remediation backups
docker/dovecot/config/*
!docker/dovecot/config/.gitkeep

# Local workspaces & generated keys (F1.3)
workspaces/
apps/api/workspaces/

# Python virtual environments & bytecode
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
apps/api/Python/

# CoreDNS generated zone database files
docker/coredns/zones/*.db
!docker/coredns/zones/.gitkeep

# Traefik SSL certificates and ACME storage
docker/traefik/acme.json
docker/traefik/certs/*.crt
docker/traefik/certs/*.key
!docker/traefik/certs/.gitkeep

# Runtime-generated per-domain Traefik dynamic configs (F3.1) — written by
# domains/service.ts at runtime, install-specific, never meant to be
# committed. webmail.yml is the one deliberately-tracked static route (F4.4).
docker/traefik/dynamic/domain-*.yml
!docker/traefik/dynamic/.gitkeep

# Rendered production Traefik config (F5.1) — generated from
# traefik.prod.yml.tmpl by the installer, contains the real admin email.
docker/traefik/traefik.prod.yml

# Production installer (F5.1)
docker-compose.prod.env

# Postfix routing maps and OpenDKIM tables/keys are runtime state the panel
# rewrites on every mailbox or domain change, and DKIM private keys must never
# be committed. Tracked state made every install "dirty" and blocked updates,
# so only the .gitkeep placeholders are tracked.
docker/postfix/config/*
!docker/postfix/config/.gitkeep
docker/postfix/opendkim/*
!docker/postfix/opendkim/.gitkeep

# Docs site (docs/): reference + project pages are generated from docs/dev,
# CONTRIBUTING.md and SECURITY.md by docs/scripts/sync-docs.mjs
docs/reference/*
!docs/reference/index.md
docs/project/*
!docs/project/index.md
docs/.vitepress/cache/
docs/.vitepress/.temp/
docs/.vitepress/dist/
